{
    "parse": [
        {
            "case": "an export from a page that sends no status",
            "message": { "content": "<x/>" },
            "reply": { "status": "flushed", "content": "<x/>" }
        },
        {
            "case": "a page that sends neither status nor content",
            "message": {},
            "reply": { "status": "clean" }
        },
        {
            "case": "a null content without status",
            "message": { "content": null },
            "reply": { "status": "clean" }
        },
        {
            "case": "an export with its revision",
            "message": { "status": "flushed", "content": "<x/>", "documentRevision": 3 },
            "reply": { "status": "flushed", "content": "<x/>", "documentRevision": 3 }
        },
        {
            "case": "a clean reply with the revision the page represents",
            "message": { "status": "clean", "documentRevision": 2 },
            "reply": { "status": "clean", "documentRevision": 2 }
        },
        {
            "case": "a host-updated reply with the revision the page represents",
            "message": { "status": "host-updated", "documentRevision": 2 },
            "reply": { "status": "host-updated", "documentRevision": 2 }
        },
        {
            "case": "an unavailable reply",
            "message": { "status": "unavailable" },
            "reply": { "status": "unavailable" }
        },
        {
            "case": "a clean reply that also carries content",
            "message": { "status": "clean", "content": "<x/>" },
            "reply": { "status": "clean" }
        },
        {
            "case": "an export without content",
            "message": { "status": "flushed" },
            "reply": { "status": "unavailable" }
        },
        {
            "case": "an unknown status",
            "message": { "status": "restored", "content": "<x/>", "documentRevision": 2 },
            "reply": { "status": "unavailable", "documentRevision": 2 }
        },
        {
            "case": "a status that is not text",
            "message": { "status": 1 },
            "reply": { "status": "unavailable" }
        },
        {
            "case": "a revision that is not a number",
            "message": { "status": "clean", "documentRevision": "2" },
            "reply": { "status": "clean" }
        },
        {
            "case": "content that is not text",
            "message": { "status": "flushed", "content": 42 },
            "reply": null
        }
    ],
    "decide": [
        {
            "case": "writes an export",
            "reply": { "status": "flushed", "content": "<export/>", "documentRevision": 1 },
            "observedSync": { "status": "synced", "content": "<page/>", "documentRevision": 1 },
            "destructive": false,
            "decision": { "kind": "writeExport", "content": "<export/>", "documentRevision": 1 }
        },
        {
            "case": "writes an export from a page that sends no revision",
            "reply": { "status": "flushed", "content": "<export/>" },
            "observedSync": null,
            "destructive": true,
            "decision": { "kind": "writeExport", "content": "<export/>" }
        },
        {
            "case": "writes an export after a sync failed, since the export holds the edit",
            "reply": { "status": "flushed", "content": "<export/>" },
            "observedSync": { "status": "failed" },
            "destructive": false,
            "decision": { "kind": "writeExport", "content": "<export/>" }
        },
        {
            "case": "keeps the host document on host-updated although a sync is unconfirmed",
            "reply": { "status": "host-updated", "documentRevision": 1 },
            "observedSync": { "status": "synced", "content": "<page/>", "documentRevision": 1 },
            "destructive": false,
            "decision": { "kind": "keepHostDocument" }
        },
        {
            "case": "keeps the host document on host-updated without a sync",
            "reply": { "status": "host-updated" },
            "observedSync": null,
            "destructive": false,
            "decision": { "kind": "keepHostDocument" }
        },
        {
            "case": "awaits the syncs the page sent on a clean reply without an observed sync",
            "reply": { "status": "clean", "documentRevision": 1 },
            "observedSync": null,
            "destructive": false,
            "decision": { "kind": "awaitSentSyncs" }
        },
        {
            "case": "awaits the syncs the page sent on a destructive clean reply without an observed sync",
            "reply": { "status": "clean", "documentRevision": 1 },
            "observedSync": null,
            "destructive": true,
            "decision": { "kind": "awaitSentSyncs" }
        },
        {
            "case": "keeps the host document when the page imported a newer revision than its sync",
            "reply": { "status": "clean", "documentRevision": 2 },
            "observedSync": { "status": "synced", "content": "<page/>", "documentRevision": 1 },
            "destructive": false,
            "decision": { "kind": "keepHostDocument" }
        },
        {
            "case": "falls back to the sync when a clean reply represents the sync's revision",
            "reply": { "status": "clean", "documentRevision": 1 },
            "observedSync": { "status": "synced", "content": "<page/>", "documentRevision": 1 },
            "destructive": false,
            "decision": { "kind": "writeObservedSync", "content": "<page/>", "documentRevision": 1 }
        },
        {
            "case": "falls back to the sync when an older page sends no revision",
            "reply": { "status": "clean" },
            "observedSync": { "status": "synced", "content": "<page/>", "documentRevision": 0 },
            "destructive": false,
            "decision": { "kind": "writeObservedSync", "content": "<page/>", "documentRevision": 0 }
        },
        {
            "case": "discards an observed sync on a destructive clean reply, which the page sends only when unedited since its last import",
            "reply": { "status": "clean", "documentRevision": 1 },
            "observedSync": { "status": "synced", "content": "<stale/>", "documentRevision": 1 },
            "destructive": true,
            "decision": { "kind": "keepHostDocument" }
        },
        {
            "case": "falls back to the sync when the page could not flush",
            "reply": { "status": "unavailable" },
            "observedSync": { "status": "synced", "content": "<page/>", "documentRevision": 1 },
            "destructive": false,
            "decision": { "kind": "writeObservedSync", "content": "<page/>", "documentRevision": 1 }
        },
        {
            "case": "falls back to the sync when the page could not flush a destructive flush",
            "reply": { "status": "unavailable" },
            "observedSync": { "status": "synced", "content": "<page/>", "documentRevision": 1 },
            "destructive": true,
            "decision": { "kind": "writeObservedSync", "content": "<page/>", "documentRevision": 1 }
        },
        {
            "case": "keeps the host document when the page could not flush but imported a newer revision than its sync",
            "reply": { "status": "unavailable", "documentRevision": 2 },
            "observedSync": { "status": "synced", "content": "<page/>", "documentRevision": 1 },
            "destructive": false,
            "decision": { "kind": "keepHostDocument" }
        },
        {
            "case": "reports a page that could not flush and sent no sync",
            "reply": { "status": "unavailable" },
            "observedSync": null,
            "destructive": false,
            "decision": { "kind": "unavailable" }
        },
        {
            "case": "refuses after a failed sync on a clean reply",
            "reply": { "status": "clean", "documentRevision": 1 },
            "observedSync": { "status": "failed" },
            "destructive": false,
            "decision": { "kind": "syncFailed" }
        },
        {
            "case": "refuses after a failed sync on a host-updated reply",
            "reply": { "status": "host-updated", "documentRevision": 1 },
            "observedSync": { "status": "failed" },
            "destructive": false,
            "decision": { "kind": "syncFailed" }
        },
        {
            "case": "refuses after a failed sync on an unavailable reply",
            "reply": { "status": "unavailable" },
            "observedSync": { "status": "failed" },
            "destructive": true,
            "decision": { "kind": "syncFailed" }
        }
    ]
}
