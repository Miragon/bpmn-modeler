{
    "name": "@miragon/bpmn-modeler-diff",
    "architecture": "hexagonal",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./domain": "./src/domain.ts",
        "./package.json": "./package.json"
    },
