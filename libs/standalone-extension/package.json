{
  "private": true,
  "name": "@miragon/bpmn-modeler-standalone-extension",
  "version": "1.16.0",
  "description": "Theia frontend extension contributing Miragon themes and view overrides for @miragon/bpmn-modeler-standalone.",
  "license": "Apache-2.0",
  "main": "lib/frontend-module.js",
  "files": [
    "lib"
  ],
  "theiaExtensions": [
    {
      "frontend": "lib/frontend-module"
    }
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.spec.json",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "@theia/core": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/monaco": "1.76.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
