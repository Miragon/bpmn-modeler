{
  "private": true,
  "name": "@miragon/bpmn-modeler-standalone-extension",
  "version": "1.14.1",
  "description": "Theia frontend extension contributing Miragon themes and view overrides for @miragon/bpmn-modeler-standalone.",
  "license": "Apache-2.0",
  "main": "lib/frontend-module.js",
  "files": [
    "lib"
  ],
  "theiaExtensions": [
    {
      "frontend": "lib/frontend-module"
    }
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "vitest run --coverage",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "@theia/core": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/monaco": "1.75.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.1.0",
    "rimraf": "6.1.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.11"
  }
}
