{
  "name": "@miragon/bpmn-modeler-core",
  "architecture": "hexagonal",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "dev": "tsc -p tsconfig.lib.json --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@miragon/bpmn-modeler-diff": "workspace:*",
    "@miragon/bpmn-modeler-shared": "workspace:*",
    "@miragon/bpmn-modeler-types": "workspace:*",
    "@miragon/bpmnlint-plugin-rules": "0.22.0",
    "@miragon/dmn-modeler-diff": "workspace:*",
    "bpmn-moddle": "10.3.1",
    "bpmnlint": "12.0.0",
    "camunda-bpmn-moddle": "8.0.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@miragon/architecture-testing": "workspace:*",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
