{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "separate-pull-requests": true,
  "changelog-sections": [
    { "type": "feat", "section": "🎉 New Features" },
    { "type": "fix", "section": "🐞 Bug Fixes" },
    { "type": "refactor", "section": "🔨 Refactoring" },
    { "type": "docs", "section": "📔 Documentation" },
    { "type": "chore", "section": "🛠️ Misc" }
  ],
  "packages": {
    ".": {
      "release-type": "node",
      "component": "vscode",
      "include-component-in-tag": true,
      "exclude-paths": ["apps/intellij-plugin"],
      "extra-files": [
        {
          "type": "json",
          "path": "apps/vscode-plugin/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/standalone/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "libs/standalone-extension/package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "apps/intellij-plugin": {
      "release-type": "simple",
      "component": "intellij",
      "include-component-in-tag": true,
      "extra-files": [{ "type": "generic", "path": "gradle.properties" }]
    }
  }
}
