{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "separate-pull-requests": true,
  "changelog-sections": [
    { "type": "feat", "section": "🎉 New Features" },
    { "type": "fix", "section": "🐞 Bug Fixes" },
    { "type": "refactor", "section": "🔨 Refactoring" },
    { "type": "docs", "section": "📔 Documentation" },
    { "type": "chore", "section": "🛠️ Misc" }
  ],
  "packages": {
    ".": {
      "release-type": "node",
      "component": "bpmn-modeler",
      "include-component-in-tag": true,
      "changelog-path": "packages/bpmn-modeler/CHANGELOG.md",
      "exclude-paths": [
        ".agent",
        ".claude",
        ".editorconfig",
        ".githooks",
        ".github",
        ".gitignore",
        ".nvmrc",
        ".prettierignore",
        ".prettierrc",
        ".release-please-manifest.json",
        ".vscode",
        ".yarn",
        ".yarnrc.yml",
        "CLAUDE.md",
        "CODE_OF_CONDUCT.md",
        "CONTRIBUTING.md",
        "LICENSE",
        "README.md",
        "apps",
        "docs",
        "eslint.config.cjs",
        "images",
        "knip.jsonc",
        "libs/modeler-core",
        "libs/shared",
        "libs/standalone-extension",
        "netlify.toml",
        "package.json",
        "portless.json",
        "release-please-config.json",
        "resources",
        "stack",
        "tsconfig.base.json",
        "vitest.config.ts",
        "yarn.config.cjs",
        "yarn.lock"
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "packages/bpmn-modeler/package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "apps/vscode-plugin": {
      "release-type": "node",
      "component": "vscode",
      "include-component-in-tag": true,
      "extra-files": [
        {
          "type": "json",
          "path": "/apps/standalone/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "/libs/standalone-extension/package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "apps/intellij-plugin": {
      "release-type": "simple",
      "component": "intellij",
      "include-component-in-tag": true,
      "extra-files": [{ "type": "generic", "path": "gradle.properties" }]
    }
  }
}
