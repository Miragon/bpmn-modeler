{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "separate-pull-requests": false,
  "changelog-sections": [
    { "type": "feat", "section": "🎉 New Features" },
    { "type": "fix", "section": "🐞 Bug Fixes" },
    { "type": "refactor", "section": "🔨 Refactoring" },
    { "type": "docs", "section": "📔 Documentation" },
    { "type": "chore", "section": "🛠️ Misc" }
  ],
  "packages": {
    "release/bpmn-modeler": {
      "release-type": "simple",
      "component": "bpmn-modeler",
      "include-component-in-tag": true,
      "changelog-path": "/packages/bpmn-modeler/CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "/packages/bpmn-modeler/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "/package.json", "jsonpath": "$.version" }
      ]
    },
    "release/vscode": {
      "release-type": "simple",
      "component": "vscode",
      "include-component-in-tag": true,
      "changelog-path": "/apps/vscode-plugin/CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "/apps/vscode-plugin/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "/apps/standalone/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "/libs/standalone-extension/package.json", "jsonpath": "$.version" }
      ]
    },
    "release/intellij": {
      "release-type": "simple",
      "component": "intellij",
      "include-component-in-tag": true,
      "changelog-path": "/apps/intellij-plugin/CHANGELOG.md",
      "extra-files": [{ "type": "generic", "path": "/apps/intellij-plugin/gradle.properties" }]
    },
    "release/orca": {
      "release-type": "simple",
      "component": "orca",
      "include-component-in-tag": true,
      "changelog-path": "/apps/orca-plugin/CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "/apps/orca-plugin/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "/apps/orca-plugin/orca-plugin.json", "jsonpath": "$.version" }
      ]
    },
    "release/dmn-modeler": {
      "release-type": "simple",
      "component": "dmn-modeler",
      "include-component-in-tag": true,
      "changelog-path": "/packages/dmn-modeler/CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "/packages/dmn-modeler/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
