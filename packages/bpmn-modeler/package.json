{
    "name": "@miragon/bpmn-modeler",
    "version": "1.3.0",
    "license": "Apache-2.0",
    "description": "Host-free, embeddable BPMN modeler (Camunda 7 & 8) built on bpmn-js.",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Miragon/bpmn-modeler.git",
        "directory": "packages/bpmn-modeler"
    },
    "homepage": "https://github.com/Miragon/bpmn-modeler/tree/main/packages/bpmn-modeler#readme",
    "bugs": {
        "url": "https://github.com/Miragon/bpmn-modeler/issues"
    },
    "keywords": [
        "bpmn",
        "bpmn-js",
        "modeler",
        "camunda",
        "camunda-7",
        "camunda-8",
        "zeebe",
        "diagram",
        "diff"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist",
        "THIRD_PARTY_NOTICES"
    ],
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./diff": {
            "types": "./dist/diff.d.ts",
            "import": "./dist/diff.js"
        },
        "./lint": {
            "types": "./dist/lint.d.ts",
            "import": "./dist/lint.js"
        },
        "./viewer": {
            "types": "./dist/viewer.d.ts",
            "import": "./dist/viewer.js"
        },
        "./design": {
            "types": "./dist/design.d.ts",
            "import": "./dist/design.js"
        },
        "./mode": {
            "types": "./dist/mode.d.ts",
            "import": "./dist/mode.js"
        },
        "./styles.css": "./dist/bpmn-modeler.css",
        "./viewer.css": "./dist/viewer.css",
        "./design.css": "./dist/design.css",
        "./mode.css": "./dist/mode.css",
        "./light-theme.css": "./dist/lightTheme.css",
        "./dark-theme.css": "./dist/darkTheme.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "npm-run-all -s check:inlined-peers typecheck build:lib check:externals build:themes build:viewer-css check:dts check:diff-node check:lint-free check:design-pure check:mode-pure check:dep-alignment",
        "build:lib": "vite build",
        "build:themes": "vite build -c vite.themes.config.mts",
        "build:viewer-css": "vite build -c vite.viewer-css.config.mts",
        "check:inlined-peers": "node scripts/check-inlined-peers.mjs",
        "check:externals": "node scripts/check-externals.mjs",
        "check:dts": "node scripts/check-dts.mjs",
        "check:diff-node": "node scripts/check-diff-node.mjs",
        "check:lint-free": "node scripts/check-lint-free-entry.mjs",
        "check:design-pure": "node scripts/check-design-pure-entry.mjs",
        "check:mode-pure": "node scripts/check-mode-pure-entry.mjs",
        "check:dep-alignment": "yarn constraints",
        "test": "vitest run --coverage",
        "test:unit": "vitest run --project bpmn-modeler",
        "test:browser": "vitest run --project bpmn-modeler-browser"
    },
    "dependencies": {
        "@bpmn-io/align-to-origin": "0.7.0",
        "@bpmn-io/cm-theme": "0.2.2",
        "@bpmn-io/element-template-icon-renderer": "1.0.1",
        "@bpmn-io/properties-panel": "3.58.0",
        "@bpmn-io/variable-resolver": "3.3.1",
        "@camunda/example-data-properties-provider": "1.5.2",
        "@lezer/lr": "1.4.11",
        "@miragon/bpmn-modeler-i18n": "0.2.0",
        "@miragon/bpmnlint-plugin-rules": "0.15.0",
        "@miragon/create-append-c7": "1.0.1",
        "bpmn-auto-layout": "2.0.0-alpha.2",
        "bpmn-js": "18.31.1",
        "bpmn-js-bpmnlint": "0.25.0",
        "bpmn-js-color-picker": "0.7.2",
        "bpmn-js-copy-as-image": "0.4.1",
        "bpmn-js-create-append-anything": "2.2.0",
        "bpmn-js-differ": "3.2.0",
        "bpmn-js-element-templates": "2.40.1",
        "bpmn-js-executable-fix": "0.2.2",
        "bpmn-js-native-copy-paste": "0.3.0",
        "bpmn-js-properties-panel": "5.65.3",
        "bpmn-js-token-simulation": "1.1.0",
        "bpmn-moddle": "10.3.1",
        "bpmnlint": "11.15.0",
        "camunda-bpmn-js-behaviors": "1.18.0",
        "camunda-bpmn-moddle": "8.0.2",
        "camunda-transaction-boundaries": "1.1.2",
        "diagram-js": "15.28.1",
        "diagram-js-grid": "2.1.0",
        "diagram-js-minimap": "5.6.0",
        "ids": "3.0.2",
        "lodash": "4.18.1",
        "min-dash": "5.1.0",
        "min-dom": "5.3.0",
        "minisearch": "7.2.0",
        "preact": "10.29.8",
        "tiny-svg": "4.1.4",
        "tslib": "2.8.1",
        "zeebe-bpmn-moddle": "2.0.0"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "7.59.4",
        "@miragon/architecture-testing": "workspace:*",
        "@miragon/bpmn-model-navigation": "workspace:*",
        "@miragon/bpmn-modeler-append-menu": "workspace:*",
        "@miragon/bpmn-modeler-clipboard": "workspace:*",
        "@miragon/bpmn-modeler-code-link": "workspace:*",
        "@miragon/bpmn-modeler-definition-search": "workspace:*",
        "@miragon/bpmn-modeler-diff": "workspace:*",
        "@miragon/bpmn-modeler-element-template-chooser": "workspace:*",
        "@miragon/bpmn-modeler-flow-navigation": "workspace:*",
        "@miragon/bpmn-modeler-i18n-extras": "workspace:*",
        "@miragon/bpmn-modeler-inline-scripting": "workspace:*",
        "@miragon/bpmn-modeler-layout": "workspace:*",
        "@miragon/bpmn-modeler-properties-panel": "workspace:*",
        "@miragon/bpmn-modeler-types": "workspace:*",
        "@types/node": "26.6.5",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vitest/browser-playwright": "5.0.5",
        "@vitest/coverage-v8": "5.0.5",
        "didi": "12.0.0",
        "jsdom": "30.1.3",
        "npm-run-all": "4.1.5",
        "playwright": "1.64.1",
        "postcss": "8.5.31",
        "postcss-selector-parser": "7.1.7",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "unplugin-dts": "1.1.2",
        "vite": "8.3.4",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "5.0.5"
    }
}
