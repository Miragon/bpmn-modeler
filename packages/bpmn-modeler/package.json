{
    "name": "@miragon/bpmn-modeler",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "description": "Host-free, embeddable BPMN modeler (Camunda 7 & 8) built on bpmn-js.",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./styles.css": "./dist/bpmn-modeler.css",
        "./light-theme.css": "./dist/lightTheme.css",
        "./dark-theme.css": "./dist/darkTheme.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "npm-run-all -s typecheck build:lib build:themes check:dts",
        "build:lib": "vite build",
        "build:themes": "vite build -c vite.themes.config.mts",
        "check:dts": "node scripts/check-dts.mjs",
        "test": "vitest run --coverage"
    },
    "dependencies": {
        "@bpmn-io/cm-theme": "0.2.2",
        "@bpmn-io/properties-panel": "3.46.0",
        "@miragon/bpmn-modeler-i18n": "0.2.0",
        "@miragon/bpmnlint-plugin-rules": "0.10.0",
        "@miragon/create-append-c7": "0.1.0",
        "bpmn-js": "18.19.0",
        "bpmn-js-bpmnlint": "0.24.0",
        "bpmn-js-create-append-anything": "2.0.0",
        "bpmn-js-native-copy-paste": "0.3.0",
        "bpmn-js-properties-panel": "5.60.0",
        "bpmn-js-token-simulation": "0.39.4",
        "bpmn-moddle": "10.0.0",
        "bpmnlint": "11.13.0",
        "camunda-bpmn-js": "5.28.0",
        "camunda-bpmn-js-behaviors": "1.17.0",
        "camunda-bpmn-moddle": "7.0.1",
        "camunda-transaction-boundaries": "1.1.2",
        "diagram-js": "15.18.0",
        "lodash": "4.18.1",
        "minisearch": "7.2.0",
        "preact": "10.29.3",
        "tslib": "2.8.1",
        "zeebe-bpmn-moddle": "1.15.0"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "7.59.0",
        "@miragon/bpmn-model-navigation": "workspace:*",
        "@miragon/bpmn-modeler-append-menu": "workspace:*",
        "@miragon/bpmn-modeler-clipboard": "workspace:*",
        "@miragon/bpmn-modeler-code-link": "workspace:*",
        "@miragon/bpmn-modeler-element-template-chooser": "workspace:*",
        "@miragon/bpmn-modeler-flow-navigation": "workspace:*",
        "@miragon/bpmn-modeler-i18n-extras": "workspace:*",
        "@miragon/bpmn-modeler-inline-scripting": "workspace:*",
        "@miragon/bpmn-modeler-types": "workspace:*",
        "@vitest/coverage-v8": "4.1.9",
        "didi": "11.0.0",
        "jsdom": "30.0.1",
        "npm-run-all": "4.1.5",
        "typescript": "6.0.3",
        "unplugin-dts": "1.0.3",
        "vite": "8.1.0",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.1.9"
    }
}
