{
    "name": "@miragon/dmn-modeler",
    "version": "0.2.0",
    "license": "Apache-2.0",
    "description": "Host-free, embeddable DMN modeler (Camunda) built on dmn-js.",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Miragon/bpmn-modeler.git",
        "directory": "packages/dmn-modeler"
    },
    "homepage": "https://github.com/Miragon/bpmn-modeler/tree/main/packages/dmn-modeler#readme",
    "bugs": {
        "url": "https://github.com/Miragon/bpmn-modeler/issues"
    },
    "keywords": [
        "dmn",
        "dmn-js",
        "modeler",
        "camunda",
        "decision-table",
        "drd"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./styles.css": "./dist/dmn-modeler.css",
        "./light-theme.css": "./dist/lightTheme.css",
        "./dark-theme.css": "./dist/darkTheme.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "typecheck:public-api": "tsc --noEmit -p tsconfig.public-api.json",
        "build": "npm-run-all -s typecheck typecheck:public-api build:lib build:themes check:dts check:externals check:dep-alignment",
        "build:lib": "vite build",
        "build:themes": "vite build -c vite.themes.config.mts",
        "check:dts": "node scripts/check-dts.mjs",
        "check:externals": "node scripts/check-externals.mjs",
        "check:dep-alignment": "yarn constraints",
        "test": "vitest run --coverage"
    },
    "dependencies": {
        "@bpmn-io/cm-theme": "0.2.2",
        "@bpmn-io/properties-panel": "3.52.0",
        "@emaarco/dmn-js-simulation": "0.2.0",
        "@miragon/bpmn-modeler-i18n": "0.2.0",
        "camunda-dmn-moddle": "1.3.1",
        "diagram-js": "15.24.1",
        "dmn-js": "17.10.2",
        "dmn-js-properties-panel": "3.12.0",
        "lodash": "4.18.1",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "7.59.0",
        "@miragon/bpmn-modeler-i18n-extras": "workspace:*",
        "@miragon/bpmn-modeler-types": "workspace:*",
        "@types/node": "26.1.2",
        "@vitest/coverage-v8": "4.1.11",
        "jsdom": "30.0.1",
        "npm-run-all": "4.1.5",
        "postcss": "8.5.26",
        "postcss-selector-parser": "7.1.1",
        "typescript": "6.0.3",
        "unplugin-dts": "1.0.3",
        "vite": "8.2.2",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.1.11"
    }
}
