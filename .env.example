# Build-time secrets for the bundled Miragon BPMN-IQ artifacts
# (apps/bpmn-iq-vscode and apps/bpmn-iq-standalone).
#
# Copy to `.env` (gitignored) and fill in.  Values are read at build time by
# webpack DefinePlugin and baked into the compiled bundle — they are not
# user-facing settings and cannot be changed at runtime.
#
# If a variable is unset, the build still succeeds (so CI without secrets
# can verify the compile step), but the resulting binary will refuse to
# start sync with a clear error pointing at this file.

# URL of the Miragon Cloud bpmn-iq daemon, e.g. https://bpmn-iq.example.test
MIRAGON_CLOUD_DAEMON_URL=
