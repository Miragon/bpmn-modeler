{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreDependencies": [
        "tslib", // injected by TS `importHelpers` (tsconfig.base.json), not imported
        "preact", // provided via `jsxImportSource: "preact"` in tsconfig.base.json
        "lint-staged", // invoked by .githooks/pre-commit, which knip does not parse
        "@types/vscode-webview", // ambient types for `acquireVsCodeApi`, no import site
        "@vscode/test-electron", // runtime of the @vscode/test-cli e2e toolchain
        "@bpmn-io/cm-theme", // version pin: @bpmn-io/feelers-editor needs 0.2.2's feelLight/feelDark
        "@bpmn-io/form-js", // copied into the extension package by webpack
        "@bpmn-io/form-json-schema" // copied into the extension package by webpack
    ],
    "ignore": [
        // bpmnlint plugin fixture: resolved at runtime by bpmnlint via the
        // `file:` dep + `.bpmnlintrc` (dynamic string require), which knip
        // cannot see statically. On CI the fixture's node_modules is absent,
        // so knip flags these unless ignored outright.
        "resources/example-process/bpmnlint-custom-rules/**",
        // Gradle build output (gitignored, absent on CI); the staged webview
        // bundles here would otherwise read as unused source locally.
        "apps/intellij-plugin/build/**",
        // Standalone i18n-overlay dev scripts: build-overlay.mjs runs via `bun`
        // by hand, harvest-drain.js is pasted into the dev webview / driven by
        // Playwright. Neither is imported, so knip reads them as unused.
        "libs/bpmn-i18n-extras/tools/**",
        // Pack-and-install smoke test: copied into a scratch dir and run by
        // publish-npm-modeler.yml (`node smoke-consumer.mjs`), never imported and
        // not a package.json script, so knip reads it as unused.
        "packages/bpmn-modeler/scripts/smoke-consumer.mjs",
        "packages/dmn-modeler/scripts/smoke-consumer.mjs",
        // Icon regeneration script, run by hand on upstream bumps
        // (`node scripts/generate-icons.mjs`), never imported.
        "libs/properties-panel/scripts/generate-icons.mjs",
        // Type declarations for the postcss plugin .mjs; reached only through
        // TS declaration resolution (sibling lookup), which knip does not track.
        "packages/bpmn-modeler/scripts/postcss-strip-theme-scope.d.mts",
        "packages/bpmn-modeler/scripts/check-externals.d.mts",
        "packages/bpmn-modeler/scripts/check-inlined-peers.d.mts",
        "packages/dmn-modeler/scripts/postcss-strip-theme-scope.d.mts"
    ],
    "ignoreWorkspaces": ["apps/standalone"],
    "workspaces": {
        "apps/vscode-plugin": {
            "entry": [
                "src/**/index.ts",
                "test/e2e/.vscode-test.mjs",
                "test/e2e/**/*.test.ts"
            ]
        },
        "apps/demo-webapp": {
            // dual.ts / diff.ts are reached only via their .html files, which the
            // vite plugin does not walk (single-mode root), so list them.
            "entry": [
                "dmn/main.ts",
                "bpmn/dual.ts",
                "bpmn/diff.ts",
                "bpmn/diffRegressions.ts",
                "bpmn/viewer.ts",
                "bpmn/design.ts"
            ]
        },
        "packages/bpmn-modeler": {
            // `src/bpmnlint/index.ts` is the public `@miragon/bpmn-modeler/lint`
            // subpath entry a host injects (#1407) and `src/diff/index.ts` the
            // public `./diff` subpath (both in package.json exports), so their
            // exports are API — list them so knip does not read them as unused.
            "entry": [
                "src/index.ts",
                "src/bpmnlint/index.ts",
                "src/diff/index.ts",
                "src/viewer/index.ts",
                "src/design/index.ts",
                "src/modeSession/index.ts"
            ],
            // minisearch (via model-navigation), lodash (via modeler-types'
            // asyncDebounce), and bpmn-js-differ (via the inlined bpmn-diff lib)
            // are pulled in only through inlined workspace libs; the Vite lib
            // build externalises them, so the published package must declare them
            // even though no package source imports them directly.
            "ignoreDependencies": [
                "minisearch",
                "lodash",
                "bpmn-js-differ",
                // Temporary upstream manifest workarounds, verified by the
                // nested packed-consumer smoke rather than package imports.
                "@lezer/lr",
                "tiny-svg"
            ]
        },
        "packages/dmn-modeler": {
            // `src/index.ts` is the public `@miragon/dmn-modeler` entry (in
            // package.json exports), so list it as the entry.
            "entry": ["src/index.ts"],
            // lodash enters as a bare side-effect import through the inlined
            // modeler-types barrel (asyncDebounce), which the Vite lib build
            // externalises; no package source imports it directly, so it must be
            // declared as a real dependency and ignored here.
            "ignoreDependencies": ["lodash"]
        }
    }
}
