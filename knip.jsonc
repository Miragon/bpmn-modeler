{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreDependencies": [
        "tslib", // injected by TS `importHelpers` (tsconfig.base.json), not imported
        "preact", // provided via `jsxImportSource: "preact"` in tsconfig.base.json
        "lint-staged", // invoked by .githooks/pre-commit, which knip does not parse
        "@types/vscode-webview", // ambient types for `acquireVsCodeApi`, no import site
        "@vscode/test-electron", // runtime of the @vscode/test-cli e2e toolchain
        "@bpmn-io/cm-theme", // version pin: @bpmn-io/feelers-editor needs 0.2.2's feelLight/feelDark
        "@bpmn-io/form-js", // copied into the extension package by webpack
        "@bpmn-io/form-json-schema" // copied into the extension package by webpack
    ],
    "ignore": [
        // bpmnlint plugin fixture: resolved at runtime by bpmnlint via the
        // `file:` dep + `.bpmnlintrc` (dynamic string require), which knip
        // cannot see statically. On CI the fixture's node_modules is absent,
        // so knip flags these unless ignored outright.
        "resources/example-process/bpmnlint-custom-rules/**",
        // Gradle build output (gitignored, absent on CI); the staged webview
        // bundles here would otherwise read as unused source locally.
        "apps/intellij-plugin/build/**",
        // Standalone i18n-overlay dev scripts: build-overlay.mjs runs via `bun`
        // by hand, harvest-drain.js is pasted into the dev webview / driven by
        // Playwright. Neither is imported, so knip reads them as unused.
        "libs/bpmn-i18n-extras/tools/**"
    ],
    "ignoreWorkspaces": ["apps/standalone"],
    "workspaces": {
        "apps/vscode-plugin": {
            "entry": [
                "src/**/index.ts",
                "test/e2e/.vscode-test.mjs",
                "test/e2e/**/*.test.ts"
            ]
        },
        "apps/demo-webapp": {
            "entry": ["dmn/main.ts"]
        }
    }
}
