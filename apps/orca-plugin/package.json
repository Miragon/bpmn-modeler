{
    "name": "@miragon/bpmn-modeler-orca",
    "architecture": "hexagonal",
    "version": "0.4.0",
    "private": true,
    "license": "Apache-2.0",
    "description": "The BPMN and DMN modelers as Orca custom editors for .bpmn and .dmn files.",
    "scripts": {
        "build": "vite build -c vite.editor.mts && node scripts/assemble-plugin.mjs",
        "test": "vitest run --coverage",
        "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.test.json",
        "test:e2e": "corepack yarn build && vitest run -c vitest.e2e.config.ts",
        "test:orca": "vitest run -c vitest.smoke.config.ts",
        "test:orca:docker": "node test/smoke/run-in-container.mjs"
    },
    "dependencies": {
        "@bpmn-io/properties-panel": "3.57.0",
        "@miragon/bpmn-modeler": "workspace:*",
        "@miragon/bpmn-modeler-i18n": "0.2.0",
        "@miragon/bpmn-modeler-i18n-extras": "workspace:*",
        "@miragon/bpmn-modeler-shared": "workspace:*",
        "@miragon/bpmn-modeler-types": "workspace:*",
        "@miragon/dmn-modeler": "workspace:*",
        "bpmn-js": "18.31.1",
        "tslib": "2.9.1"
    },
    "devDependencies": {
        "@miragon/modeler-shell": "0.14.1",
        "@types/node": "26.6.6",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vitest/coverage-v8": "5.1.0",
        "jsdom": "30.1.3",
        "playwright": "1.64.1",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "vite": "8.3.6",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "5.1.0"
    }
}
