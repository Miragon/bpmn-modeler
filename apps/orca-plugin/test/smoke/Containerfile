# The Orca smoke test's Linux environment: Xvfb, Electron's runtime libraries,
# fonts, and an Orca release's AppImage extracted, so it runs without FUSE.
# Bookworm, not trixie: trixie renamed several of the libraries Electron links.
FROM docker.io/library/node:22.23.4-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    dbus-x11 \
    git \
    xauth \
    xvfb \
    fonts-dejavu-core \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libexpat1 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libsecret-1-0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxkbcommon0 \
    libxkbfile1 \
    libxrandr2 \
    libxshmfence1 \
    libxss1 \
    libxtst6 \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable

ARG ORCA_VERSION
RUN mkdir -p /opt/orca && cd /opt/orca \
  && asset=$([ "$(dpkg --print-architecture)" = arm64 ] && echo orca-linux-arm64.AppImage || echo orca-linux.AppImage) \
  && curl -fsSL --http1.1 --retry 3 -o orca.AppImage "https://github.com/stablyai/orca/releases/download/v${ORCA_VERSION}/${asset}" \
  && chmod +x orca.AppImage && ./orca.AppImage --appimage-extract > /dev/null && rm orca.AppImage

ENV ORCA_APP=/opt/orca/squashfs-root \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    CI=1
