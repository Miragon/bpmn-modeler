{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "bpmn-modeler",
  "name": "BPMN & DMN Modeler",
  "version": "0.0.0",
  "description": "Open .bpmn and .dmn files as diagrams: view, simulate and lightly model BPMN processes and DMN decisions, and see an agent's changes to the file as they happen.",
  "author": {
    "name": "Miragon GmbH",
    "url": "https://www.miragon.io"
  },
  "repository": "https://github.com/Miragon/bpmn-modeler",
  "homepage": "https://miragon.github.io/bpmn-modeler/",
  "license": "Apache-2.0",
  "icon": "assets/icon.png",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "sandboxed-ui",
  "pluginApi": 1,
  "contributes": {
    "customEditors": [
      {
        "id": "bpmn",
        "title": "BPMN Modeler",
        "extensions": [".bpmn"],
        "entry": "editor/bpmn/index.html",
        "frame": "isolated"
      },
      {
        "id": "dmn",
        "title": "DMN Modeler",
        "extensions": [".dmn"],
        "entry": "editor/dmn/index.html",
        "frame": "isolated"
      }
    ]
  }
}
