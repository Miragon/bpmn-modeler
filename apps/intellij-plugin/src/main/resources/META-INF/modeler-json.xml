<idea-plugin>
    <extensions defaultExtensionNs="JavaScript.JsonSchema">
        <!-- Associates the bundled JSON Schema with deployment-targets.json
             (validation + completion + hover docs). Same schema as the VS Code
             jsonValidation contribution. See ModelerJsonSchemaProviderFactory. -->
        <ProviderFactory
            implementation="io.miragon.intellij.bpmn.ModelerJsonSchemaProviderFactory"/>
    </extensions>
</idea-plugin>
