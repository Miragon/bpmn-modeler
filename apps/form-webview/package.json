{
    "name": "@miragon/form-modeler-webview",
    "version": "0.0.1",
    "license": "Apache-2.0",
    "private": true,
    "description": "Webview frontend for the Camunda Form editor in BPMN Modeler.",
    "scripts": {
        "build": "tsc --noEmit -p tsconfig.app.json && vite build",
        "watch": "vite build --watch",
        "serve": "vite --host 127.0.0.1",
        "dev": "portless",
        "dev:app": "vite --port $PORT --host 127.0.0.1",
        "test": "vitest run --coverage",
        "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json"
    },
    "dependencies": {
        "@bpmn-io/cm-theme": "0.2.2",
        "@bpmn-io/form-js-editor": "2.1.1",
        "@bpmn-io/form-js-viewer": "2.1.1",
        "@codemirror/state": "6.7.6",
        "@miragon/bpmn-modeler-shared": "workspace:*",
        "@miragon/bpmn-modeler-types": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "@types/vscode-webview": "1.57.5",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vitest/coverage-v8": "5.0.5",
        "jsdom": "30.1.3",
        "portless": "0.15.12",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "vite": "8.3.5",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "5.0.5"
    }
}
