{
    "name": "@miragon/dmn-modeler-webview",
    "version": "0.0.1",
    "private": true,
    "license": "Apache-2.0",
    "description": "Webview frontend for the DMN modeler in BPMN Modeler.",
    "scripts": {
        "build": "vite build",
        "dev": "portless",
        "dev:app": "vite --port $PORT --host 127.0.0.1",
        "watch": "vite build --watch",
        "serve": "vite",
        "test": "vitest run --coverage"
    },
    "dependencies": {
        "@miragon/bpmn-modeler-i18n": "0.2.0",
        "@miragon/bpmn-modeler-shared": "workspace:*",
        "@miragon/bpmn-modeler-types": "workspace:*",
        "@miragon/dmn-modeler": "workspace:*",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@types/node": "26.5.1",
        "@types/vscode-webview": "1.57.5",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vitest/coverage-v8": "4.1.11",
        "jsdom": "30.0.1",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "vite": "8.3.0",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.1.11"
    }
}
