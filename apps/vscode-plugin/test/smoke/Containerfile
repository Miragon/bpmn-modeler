# The VS Code smoke test's Linux environment: Xvfb, Electron's runtime
# libraries, fonts for the workbench, and the headers and toolchain the full
# `yarn install` compiles Theia's native modules against. Bookworm, not trixie:
# trixie renamed several of the libraries Electron links (the t64 transition).
FROM docker.io/library/node:22.23.4-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    unzip \
    xauth \
    xvfb \
    fonts-dejavu-core \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libexpat1 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libsecret-1-0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxkbcommon0 \
    libxkbfile1 \
    libxrandr2 \
    libxshmfence1 \
    libxss1 \
    libxtst6 \
    g++ \
    make \
    python3 \
    libsecret-1-dev \
    libx11-dev \
    libxkbfile-dev \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    ELECTRON_SKIP_BINARY_DOWNLOAD=1 \
    CI=1
