{
    "name": "vs-code-bpmn-modeler",
    "scripts": {
        "build": "webpack --mode production",
        "dev": "webpack --mode development --watch",
        "test": "vitest run --coverage",
        "compile:e2e": "tsc -p test/e2e/tsconfig.json",
        "test:e2e": "tsc -p test/e2e/tsconfig.json && vscode-test --config test/e2e/.vscode-test.mjs"
    },
    "dependencies": {
        "@miragon/bpmn-modeler-core": "workspace:*",
        "@miragon/bpmn-modeler-i18n": "workspace:*",
        "@miragon/bpmn-modeler-shared": "workspace:*",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@types/mocha": "10.0.10",
        "@types/node": "25.9.4",
        "@types/vscode": "1.93.0",
        "@vitest/coverage-v8": "4.1.9",
        "@vscode/test-cli": "0.0.15",
        "@vscode/test-electron": "3.0.0",
        "archunit": "2.3.0",
        "copy-webpack-plugin": "14.0.0",
        "ts-loader": "9.6.2",
        "tsconfig-paths-webpack-plugin": "4.2.0",
        "typescript": "6.0.3",
        "vitest": "4.1.9",
        "webpack": "5.108.1",
        "webpack-cli": "7.0.3"
    },
    "displayName": "BPMN Modeler",
    "description": "Create and edit BPMN 2.0 and DMN diagrams in VS Code. Supports Camunda 7 and Camunda 8.",
    "license": "SEE LICENSE IN LICENSE",
    "version": "1.6.1",
    "publisher": "miragon-gmbh",
    "homepage": "https://www.miragon.io/",
    "galleryBanner": {
        "color": "#F0F8FF",
        "theme": "light"
    },
    "badges": [
        {
            "url": "https://img.shields.io/badge/Follow-@miragon__io-1DA1F2?style=social&logo=twitter&logoColor=1DA1F2",
            "href": "https://twitter.com/miragon_io",
            "description": "Our Twitter profile."
        },
        {
            "url": "https://img.shields.io/badge/Follow-miragon-blue?style=social&logo=linkedin&logoColor=blue&url=https://www.linkedin.com/company/miragon-io",
            "href": "https://www.linkedin.com/company/miragon-io",
            "description": "Our LinkedIn profile."
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Miragon/bpmn-modeler.git"
    },
    "bugs": {
        "url": "https://github.com/Miragon/bpmn-modeler/issues"
    },
    "engines": {
        "vscode": "^1.76.0"
    },
    "icon": "assets/miragon-logo.png",
    "categories": [
        "Visualization",
        "Other"
    ],
    "keywords": [
        "BPMN",
        "DMN",
        "bpmn.io",
        "Modeler",
        "Camunda",
        "Camunda Modeler",
        "Automation",
        "business process",
        "decision table"
    ],
    "main": "main.js",
    "contributes": {
        "walkthroughs": [
            {
                "id": "getStarted",
                "title": "Get Started with BPMN Modeler",
                "description": "Create, edit, and deploy BPMN 2.0 and DMN diagrams directly in VS Code.",
                "steps": [
                    {
                        "id": "create",
                        "title": "Create your first diagram",
                        "description": "Create a new file and save it as `.bpmn` (process) or `.dmn` (decision) — VS Code opens it in the graphical modeler.\n[New file](command:workbench.action.files.newUntitledFile)",
                        "media": {
                            "markdown": "media/walkthrough/create.md"
                        },
                        "completionEvents": [
                            "onStepSelected"
                        ]
                    },
                    {
                        "id": "learn",
                        "title": "Learn the basics",
                        "description": "Add and connect elements from the palette, then edit their Camunda 7 / Camunda 8 attributes in the properties panel.",
                        "media": {
                            "markdown": "media/walkthrough/learn.md"
                        },
                        "completionEvents": [
                            "onStepSelected"
                        ]
                    },
                    {
                        "id": "deploy",
                        "title": "Deploy your diagram",
                        "description": "Deploy a BPMN diagram to a Camunda 7 or Camunda 8 engine straight from the editor.\n[Deploy Diagram](command:bpmn-modeler.deployDiagram)",
                        "media": {
                            "markdown": "media/walkthrough/deploy.md"
                        },
                        "completionEvents": [
                            "onCommand:bpmn-modeler.deployDiagram"
                        ]
                    }
                ]
            }
        ],
        "jsonValidation": [
            {
                "fileMatch": "*.bpmn.vars.json",
                "url": "./schemas/bpmn-vars.schema.json"
            }
        ],
        "languages": [
            {
                "id": "bpmn",
                "aliases": [
                    "BPMN"
                ],
                "extensions": [
                    ".bpmn"
                ],
                "icon": {
                    "light": "./icons/bpmn-light.svg",
                    "dark": "./icons/bpmn-dark.svg"
                },
                "configuration": "./syntaxes/xml.language-configuration.json"
            },
            {
                "id": "dmn",
                "aliases": [
                    "DMN"
                ],
                "extensions": [
                    ".dmn"
                ],
                "icon": {
                    "light": "./icons/dmn-light.svg",
                    "dark": "./icons/dmn-dark.svg"
                },
                "configuration": "./syntaxes/xml.language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "bpmn",
                "scopeName": "text.xml.bpmn",
                "path": "./syntaxes/bpmn.tmLanguage.json"
            },
            {
                "language": "dmn",
                "scopeName": "text.xml.dmn",
                "path": "./syntaxes/dmn.tmLanguage.json"
            }
        ],
        "customEditors": [
            {
                "id": "bpmn-modeler.bpmn",
                "viewType": "bpmn-modeler.bpmn",
                "displayName": "BPMN Modeler",
                "selector": [
                    {
                        "filenamePattern": "*.bpmn"
                    }
                ],
                "priority": "default"
            },
            {
                "id": "bpmn-modeler.dmn",
                "viewType": "bpmn-modeler.dmn",
                "displayName": "DMN Modeler",
                "selector": [
                    {
                        "filenamePattern": "*.dmn"
                    }
                ],
                "priority": "default"
            }
        ],
        "configurationDefaults": {
            "workbench.editorAssociations": {
                "*.bpmn": "bpmn-modeler.bpmn",
                "*.dmn": "bpmn-modeler.dmn"
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "bpmn-modeler-deploy",
                    "title": "Deploy Diagram",
                    "icon": "$(rocket)"
                }
            ]
        },
        "views": {
            "bpmn-modeler-deploy": [
                {
                    "type": "webview",
                    "id": "bpmn-modeler.deploymentView",
                    "name": "Deploy Diagram",
                    "when": "bpmn-modeler.openCustomEditors > 0"
                }
            ]
        },
        "commands": [
            {
                "command": "bpmn-modeler.toggleTextEditor",
                "title": "Toggle Standard Text Editor",
                "category": "Miragon BPMN Modeler",
                "icon": "$(notebook-mimetype)"
            },
            {
                "command": "bpmn-modeler.openLoggingConsole",
                "title": "Display Logging Information",
                "category": "Miragon BPMN Modeler",
                "icon": "$(callstack-view-session)"
            },
            {
                "command": "bpmn-modeler.copyDiagramAsSvg",
                "title": "Copy Diagram as SVG",
                "category": "Miragon BPMN Modeler"
            },
            {
                "command": "bpmn-modeler.saveDiagramAsSvgCommand",
                "title": "Save Diagram as SVG",
                "category": "Miragon BPMN Modeler"
            },
            {
                "command": "bpmn-modeler.openAllScriptTasks",
                "title": "Generate Script Files for Script Tasks",
                "category": "Miragon BPMN Modeler"
            },
            {
                "command": "bpmn-modeler.deployDiagram",
                "title": "Deploy Diagram",
                "category": "Miragon BPMN Modeler",
                "icon": "$(rocket)"
            },
            {
                "command": "bpmn-modeler.changeEngineVersion",
                "title": "Change Engine Version",
                "category": "Miragon BPMN Modeler"
            },
            {
                "command": "bpmn-modeler.migrateAllDiagrams",
                "title": "Migrate All BPMN Diagrams",
                "category": "Miragon BPMN Modeler"
            },
            {
                "command": "bpmn-modeler.changeLanguage",
                "title": "Change Modeler Language",
                "category": "Miragon BPMN Modeler"
            },
            {
                "command": "bpmn-modeler.addMarketplace",
                "title": "Add Marketplace",
                "category": "Miragon BPMN Modeler"
            },
            {
                "command": "bpmn-modeler.updateMarketplaces",
                "title": "Update Marketplaces",
                "category": "Miragon BPMN Modeler"
            },
            {
                "command": "bpmn-modeler.removeMarketplace",
                "title": "Remove Marketplace",
                "category": "Miragon BPMN Modeler"
            },
            {
                "command": "bpmn-modeler.selectForCompare",
                "title": "Select for Compare",
                "category": "Miragon BPMN Modeler"
            },
            {
                "command": "bpmn-modeler.compareWithSelected",
                "title": "Compare with Selected",
                "category": "Miragon BPMN Modeler"
            },
            {
                "command": "bpmn-modeler.compareSelected",
                "title": "Compare Selected",
                "category": "Miragon BPMN Modeler"
            },
            {
                "command": "bpmn-modeler.newBpmnModel",
                "title": "New BPMN Model",
                "shortTitle": "BPMN Model",
                "category": "Miragon BPMN Modeler"
            },
            {
                "command": "bpmn-modeler.newDmnModel",
                "title": "New DMN Model",
                "shortTitle": "DMN Model",
                "category": "Miragon BPMN Modeler"
            },
            {
                "command": "bpmn-modeler.reloadModeler",
                "title": "Reload Modeler",
                "category": "Miragon BPMN Modeler",
                "icon": "$(refresh)"
            }
        ],
        "keybindings": [
            {
                "command": "bpmn-modeler.toggleTextEditor",
                "key": "ctrl+shift+e",
                "when": "bpmn-modeler.openCustomEditors > 0"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "bpmn-modeler.toggleTextEditor",
                    "when": "bpmn-modeler.openCustomEditors > 0"
                },
                {
                    "command": "bpmn-modeler.openLoggingConsole",
                    "when": "bpmn-modeler.openCustomEditors > 0"
                },
                {
                    "command": "bpmn-modeler.copyDiagramAsSvg",
                    "when": "bpmn-modeler.openCustomEditors > 0"
                },
                {
                    "command": "bpmn-modeler.saveDiagramAsSvgCommand",
                    "when": "bpmn-modeler.openCustomEditors > 0"
                },
                {
                    "command": "bpmn-modeler.openAllScriptTasks",
                    "when": "bpmn-modeler.openCustomEditors > 0"
                },
                {
                    "command": "bpmn-modeler.deployDiagram",
                    "when": "bpmn-modeler.openCustomEditors > 0"
                },
                {
                    "command": "bpmn-modeler.changeEngineVersion",
                    "when": "bpmn-modeler.openCustomEditors > 0"
                },
                {
                    "command": "bpmn-modeler.migrateAllDiagrams",
                    "when": "workspaceFolderCount > 0"
                },
                {
                    "command": "bpmn-modeler.changeLanguage",
                    "when": "bpmn-modeler.openCustomEditors > 0"
                },
                {
                    "command": "bpmn-modeler.reloadModeler",
                    "when": "bpmn-modeler.openCustomEditors > 0"
                },
                {
                    "command": "bpmn-modeler.selectForCompare",
                    "when": "false"
                },
                {
                    "command": "bpmn-modeler.compareWithSelected",
                    "when": "false"
                },
                {
                    "command": "bpmn-modeler.compareSelected",
                    "when": "false"
                }
            ],
            "explorer/context": [
                {
                    "command": "bpmn-modeler.selectForCompare",
                    "group": "3_compare",
                    "when": "resourceExtname == .bpmn && !listMultiSelection"
                },
                {
                    "command": "bpmn-modeler.compareWithSelected",
                    "group": "3_compare",
                    "when": "resourceExtname == .bpmn && bpmn-modeler.compareSelectionActive && !listMultiSelection"
                },
                {
                    "command": "bpmn-modeler.compareSelected",
                    "group": "3_compare",
                    "when": "resourceExtname == .bpmn && listDoubleSelection"
                }
            ],
            "editor/title": [
                {
                    "command": "bpmn-modeler.toggleTextEditor",
                    "group": "navigation",
                    "when": "activeWebviewPanelId == 'bpmn-modeler.bpmn' || activeWebviewPanelId == 'bpmn-modeler.dmn'"
                },
                {
                    "command": "bpmn-modeler.deployDiagram",
                    "group": "navigation",
                    "when": "activeWebviewPanelId == 'bpmn-modeler.bpmn'"
                }
            ],
            "file/newFile": [
                {
                    "command": "bpmn-modeler.newBpmnModel",
                    "group": "file"
                },
                {
                    "command": "bpmn-modeler.newDmnModel",
                    "group": "file"
                }
            ]
        },
        "configuration": {
            "title": "BPMN Modeler",
            "properties": {
                "miragon.bpmnModeler.alignToOrigin": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Align the diagram to the origin when opening a new diagram. Click [here](https://github.com/bpmn-io/align-to-origin) to see the behaviour when enabled."
                },
                "miragon.bpmnModeler.scripting.spin": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Offer Camunda SPIN globals (`S(…)`, `JSON(…)`) and SpinJsonNode member completion in inline Camunda 7 scripts. Disable if your project does not have camunda-spin on the classpath."
                },
                "miragon.bpmnModeler.configFolder": {
                    "type": "string",
                    "default": ".camunda",
                    "markdownDescription": "Name of the config folder searched at each directory level from the BPMN file up to the workspace root. **Element templates must be placed under `<config>/element-templates/`** (e.g. `.camunda/element-templates/my-template.json`)."
                },
                "miragon.bpmnModeler.persistCodeLinkMap": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Persist the activity→code map to `<configFolder>/code-link/<file>.json` (e.g. `.camunda/code-link/order-process.bpmn.json`). The map drives the **Go to implementation** context-pad entry's visibility and works in memory regardless of this setting; the on-disk file is an opt-in warm cache (faster re-open) and a machine-readable artifact for external/AI tooling. Off by default."
                },
                "miragon.bpmnModeler.c8ApiVersion": {
                    "type": "string",
                    "default": "v2",
                    "markdownDescription": "REST API version prefix for Camunda 8 endpoints (e.g. `v2`). Change this if your Camunda 8 cluster uses a different API version."
                },
                "miragon.bpmnModeler.showTransactionBoundaries": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show transaction boundaries in the BPMN diagram (Camunda 7 only). Click [here](https://docs.camunda.io/docs/8.7/components/best-practices/development/understanding-transaction-handling-c7/) to learn more."
                },
                "miragon.bpmnModeler.colorTheme": {
                    "type": "string",
                    "default": "automatic",
                    "enum": [
                        "automatic",
                        "light"
                    ],
                    "enumItemLabels": [
                        "Automatic (follow VS Code theme)",
                        "Light"
                    ],
                    "markdownDescription": "Controls the color theme of the BPMN modeler canvas. `automatic` follows the active VS Code theme; `light` always uses the default bpmn-js light theme."
                },
                "miragon.bpmnModeler.favouriteBpmnElements": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "bpmn:ServiceTask",
                        "bpmn:UserTask",
                        "bpmn:CallActivity",
                        "bpmn:ExclusiveGateway"
                    ],
                    "maxItems": 6,
                    "markdownDescription": "BPMN element types to pin at the top of the append menu palette (max 6). Use BPMN type names like `bpmn:ServiceTask`, `bpmn:UserTask`, `bpmn:CallActivity`, `bpmn:ExclusiveGateway`."
                },
                "miragon.bpmnModeler.language": {
                    "type": "string",
                    "default": "en",
                    "enum": [
                        "de",
                        "en",
                        "es",
                        "fr",
                        "nl-nl",
                        "pt-br",
                        "ru",
                        "zh-Hans",
                        "zh-Hant"
                    ],
                    "enumItemLabels": [
                        "Deutsch",
                        "English",
                        "Español",
                        "Français",
                        "Nederlands",
                        "Português (Brasil)",
                        "Русский",
                        "简体中文",
                        "繁体中文"
                    ],
                    "markdownDescription": "UI language for the BPMN/DMN modeler (palette, context pad, properties panel)."
                },
                "miragon.bpmnModeler.marketplaces": {
                    "type": "array",
                    "scope": "window",
                    "items": {
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "object",
                                "required": [
                                    "provider",
                                    "repo"
                                ],
                                "properties": {
                                    "provider": {
                                        "enum": [
                                            "github",
                                            "gitlab"
                                        ]
                                    },
                                    "repo": {
                                        "type": "string",
                                        "markdownDescription": "`owner/repo` for GitHub, or `group/subgroup/project` for GitLab."
                                    },
                                    "baseUrl": {
                                        "type": "string",
                                        "format": "uri",
                                        "markdownDescription": "Base URL of a self-hosted GitHub Enterprise or GitLab instance (omit for the public host)."
                                    },
                                    "ref": {
                                        "type": "string",
                                        "markdownDescription": "Branch, tag, or commit to pin (omit for the default branch)."
                                    }
                                },
                                "additionalProperties": false
                            }
                        ]
                    },
                    "default": [],
                    "markdownDescription": "GitHub/GitLab repositories or local folders holding a `marketplace.json` that links to element templates. Public hosts can be a pasted URL string; a self-hosted GitHub Enterprise or GitLab is an object entry `{ \"provider\": \"github\"|\"gitlab\", \"repo\": \"…\", \"baseUrl\": \"https://…\", \"ref\": \"…\" }`. User- and Workspace-level entries are **merged** — put shared marketplaces in your User settings (\"all my projects\") and project-specific ones in the workspace. Use the `BPMN Modeler: Add Marketplace` command to register a public one; it writes to Workspace settings when a folder is open (else User). Then `BPMN Modeler: Update Marketplaces` to re-fetch. `BPMN Modeler: Remove Marketplace` unregisters one or more (multi-select) and prunes their cached templates without re-fetching the rest. Cached templates merge with workspace-local ones."
                }
            }
        }
    }
}
