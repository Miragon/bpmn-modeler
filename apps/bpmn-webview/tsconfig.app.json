{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["node", "vite/client"],
    "allowArbitraryExtensions": true,
    "noFallthroughCasesInSwitch": false
  },
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"],
  "include": [
    "src/**/*.ts",
    "../../packages/bpmn-modeler/src/types/*.d.ts",
    "../../libs/properties-panel/src/types/bpmn-io-properties-panel.d.ts",
    "../../libs/element-template-builder/src/types/element-templates-validator.d.ts"
  ]
}
