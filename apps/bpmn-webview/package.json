{
    "name": "@miragon/bpmn-modeler-webview",
    "version": "0.0.1",
    "private": true,
    "license": "Apache-2.0",
    "description": "Webview frontend for the BPMN modeler.",
    "scripts": {
        "build": "vite build",
        "dev": "portless",
        "dev:app": "vite --port $PORT --host 127.0.0.1",
        "watch": "vite build --watch",
        "serve": "vite",
        "test": "vitest run --coverage"
    },
    "dependencies": {
        "@bpmn-io/properties-panel": "3.52.0",
        "@miragon/bpmn-modeler": "workspace:*",
        "@miragon/bpmn-modeler-i18n": "0.2.0",
        "@miragon/bpmn-modeler-shared": "workspace:*",
        "@miragon/bpmn-modeler-types": "workspace:*",
        "@miragon/bpmnlint-plugin-rules": "0.10.0",
        "bpmn-js": "18.25.1",
        "bpmn-js-bpmnlint": "0.24.0",
        "bpmnlint": "11.13.0",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@types/vscode-webview": "1.57.5",
        "@vitest/coverage-v8": "4.1.11",
        "jsdom": "30.0.1",
        "typescript": "6.0.3",
        "vite": "8.2.2",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.1.11"
    }
}
