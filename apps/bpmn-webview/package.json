{
    "name": "@miragon/bpmn-modeler-webview",
    "version": "0.0.1",
    "private": true,
    "license": "Apache-2.0",
    "description": "Webview frontend for the BPMN modeler.",
    "scripts": {
        "build": "vite build",
        "dev": "portless",
        "dev:app": "vite --port $PORT --host 127.0.0.1",
        "watch": "vite build --watch",
        "serve": "vite",
        "test": "vitest run --coverage",
        "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json"
    },
    "dependencies": {
        "@bpmn-io/properties-panel": "3.57.0",
        "@bpmn-io/svg-to-image": "1.0.1",
        "@miragon/bpmn-modeler": "workspace:*",
        "@miragon/bpmn-modeler-element-template-builder": "workspace:*",
        "@miragon/bpmn-modeler-i18n": "0.2.0",
        "@miragon/bpmn-modeler-i18n-extras": "workspace:*",
        "@miragon/bpmn-modeler-shared": "workspace:*",
        "@miragon/bpmn-modeler-types": "workspace:*",
        "@miragon/bpmnlint-plugin-rules": "0.15.0",
        "bpmn-auto-layout": "2.0.0-alpha.2",
        "bpmn-js": "18.31.0",
        "bpmn-js-bpmnlint": "0.25.0",
        "bpmnlint": "11.15.0",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@types/vscode-webview": "1.57.5",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vitest/coverage-v8": "5.0.5",
        "jsdom": "30.1.3",
        "portless": "0.15.8",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "vite": "8.3.4",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "5.0.5"
    }
}
