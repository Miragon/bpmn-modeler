{
    "name": "@miragon/bpmn-modeler-demo-webapp",
    "version": "0.0.1",
    "private": true,
    "description": "Static, client-side browser demo of the BPMN/DMN modeler. Reuses the webview apps' bootstrap() with a demo host; never shipped to a real host.",
    "scripts": {
        "build:bpmn": "vite build --mode bpmn",
        "build:dmn": "vite build --mode dmn",
        "build": "npm-run-all -s build:bpmn build:dmn",
        "serve:bpmn": "vite --mode bpmn",
        "preview": "node serve-demo.mjs"
    },
    "dependencies": {
        "@miragon/bpmn-modeler": "workspace:*",
        "@miragon/bpmn-modeler-shared": "workspace:*",
        "@miragon/bpmn-modeler-webview": "workspace:*",
        "@miragon/dmn-modeler-webview": "workspace:*"
    },
    "devDependencies": {
        "npm-run-all": "4.1.5",
        "vite": "8.1.0",
        "vite-tsconfig-paths": "6.1.1"
    }
}
