{
    "$comment": "A save, then a read of the same slot, as the IntelliJ host answers them over PasswordSafe. RpcSecretStore.contract.spec.ts runs these rows against intellijCredentialHost, SecretStoreRouterTest against SecretStoreRouter on the platform's unit-test PasswordSafe.",
    "cases": [
        {
            "name": "basic-auth with both halves comes back as saved",
            "save": {
                "method": "secretStore/saveBasicAuth",
                "params": { "username": "demo", "password": "secret" }
            },
            "read": "secretStore/getBasicAuth",
            "result": { "username": "demo", "password": "secret" }
        },
        {
            "name": "basic-auth with an empty username comes back absent",
            "save": {
                "method": "secretStore/saveBasicAuth",
                "params": { "username": "", "password": "secret" }
            },
            "read": "secretStore/getBasicAuth",
            "result": null
        },
        {
            "name": "basic-auth with an empty password comes back as saved",
            "save": {
                "method": "secretStore/saveBasicAuth",
                "params": { "username": "demo", "password": "" }
            },
            "read": "secretStore/getBasicAuth",
            "result": { "username": "demo", "password": "" }
        },
        {
            "name": "OAuth2 with both halves comes back as saved",
            "save": {
                "method": "secretStore/saveOAuth2",
                "params": { "clientId": "zeebe", "clientSecret": "xyz" }
            },
            "read": "secretStore/getOAuth2",
            "result": { "clientId": "zeebe", "clientSecret": "xyz" }
        },
        {
            "name": "OAuth2 with an empty client id comes back absent",
            "save": {
                "method": "secretStore/saveOAuth2",
                "params": { "clientId": "", "clientSecret": "xyz" }
            },
            "read": "secretStore/getOAuth2",
            "result": null
        },
        {
            "name": "OAuth2 with an empty client secret comes back as saved",
            "save": {
                "method": "secretStore/saveOAuth2",
                "params": { "clientId": "zeebe", "clientSecret": "" }
            },
            "read": "secretStore/getOAuth2",
            "result": { "clientId": "zeebe", "clientSecret": "" }
        }
    ]
}
