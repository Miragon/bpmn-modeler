{
    "name": "bpmn-modeler",
    "version": "1.4.0",
    "license": "Apache-2.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "libs/*",
        "packages/*",
        "tools/*",
        "docs"
    ],
    "scripts": {
        "build": "npm-run-all -s build:libs -p build:bpmn-modeler build:dmn-modeler build:bpmn-webview build:dmn-webview build:form-webview build:deployment-webview -s build:plugin",
        "build:bpmn-modeler": "corepack yarn workspace @miragon/bpmn-modeler build",
        "build:dmn-modeler": "corepack yarn workspace @miragon/dmn-modeler build",
        "build:libs": "npm-run-all build:lib:diff build:lib:types build:lib:shared build:lib:modeler-core",
        "build:lib:diff": "corepack yarn workspace @miragon/bpmn-modeler-diff build",
        "build:lib:types": "corepack yarn workspace @miragon/bpmn-modeler-types build",
        "build:lib:shared": "corepack yarn workspace @miragon/bpmn-modeler-shared build",
        "build:lib:modeler-core": "corepack yarn workspace @miragon/bpmn-modeler-core build",
        "build:bpmn-webview": "corepack yarn workspace @miragon/bpmn-modeler-webview build",
        "build:dmn-webview": "corepack yarn workspace @miragon/dmn-modeler-webview build",
        "build:form-webview": "corepack yarn workspace @miragon/form-modeler-webview build",
        "build:deployment-webview": "corepack yarn workspace @miragon/bpmn-modeler-deployment-webview build",
        "build:plugin": "corepack yarn workspace vs-code-bpmn-modeler build",
        "build:bridge": "corepack yarn workspace @miragon/bpmn-modeler-bridge build",
        "build:bridge:compile": "corepack yarn workspace @miragon/bpmn-modeler-bridge compile",
        "intellij:build": "npm-run-all -s build:libs -p build:bpmn-webview build:deployment-webview build:bridge:compile",
        "intellij:runide": "cd apps/intellij-plugin && ./gradlew runIde",
        "intellij:run": "npm-run-all -s intellij:build intellij:runide",
        "dev:libs": "npm-run-all dev:lib:shared dev:lib:modeler-core",
        "dev:lib:shared": "corepack yarn workspace @miragon/bpmn-modeler-shared dev",
        "dev:lib:modeler-core": "corepack yarn workspace @miragon/bpmn-modeler-core dev",
        "dev:bpmn-webview": "corepack yarn workspace @miragon/bpmn-modeler-webview dev",
        "dev:dmn-webview": "corepack yarn workspace @miragon/dmn-modeler-webview dev",
        "dev:form-webview": "corepack yarn workspace @miragon/form-modeler-webview dev",
        "dev:deployment-webview": "corepack yarn workspace @miragon/bpmn-modeler-deployment-webview dev",
        "dev:plugin": "corepack yarn workspace vs-code-bpmn-modeler dev",
        "watch": "npm-run-all -s build:libs build:bpmn-webview build:dmn-webview build:form-webview build:deployment-webview -p dev:libs watch:bpmn-webview watch:dmn-webview watch:form-webview watch:deployment-webview dev:plugin",
        "watch:bpmn-webview": "corepack yarn workspace @miragon/bpmn-modeler-webview watch",
        "watch:dmn-webview": "corepack yarn workspace @miragon/dmn-modeler-webview watch",
        "watch:form-webview": "corepack yarn workspace @miragon/form-modeler-webview watch",
        "watch:deployment-webview": "corepack yarn workspace @miragon/bpmn-modeler-deployment-webview watch",
        "docs:dev": "corepack yarn workspace @miragon/bpmn-modeler-docs dev",
        "docs:build": "corepack yarn workspace @miragon/bpmn-modeler-docs build",
        "docs:preview": "corepack yarn workspace @miragon/bpmn-modeler-docs preview",
        "docs:test": "corepack yarn workspace @miragon/bpmn-modeler-docs test",
        "test": "vitest run",
        "test:mutation": "corepack yarn workspace @miragon/bpmn-modeler-core test:mutation",
        "test:coverage": "corepack yarn workspaces foreach --all --exclude bpmn-modeler --exclude @miragon/bpmn-modeler-docs run test",
        "perf:gen-model": "node scripts/perf/gen-large-bpmn.mjs",
        "perf:webview": "node scripts/perf/bench-webview.mjs",
        "perf:lint": "node scripts/perf/bench-lint-rules.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "knip": "knip",
        "knip:fix": "knip --fix",
        "format": "prettier \"**/*.{ts,tsx,cts,mts,js,jsx,cjs,mjs,vue}\" --write",
        "format:check": "prettier \"**/*.{ts,tsx,cts,mts,js,jsx,cjs,mjs,vue}\" --check",
        "prepare": "git config core.hooksPath .githooks"
    },
    "lint-staged": {
        "*.{ts,tsx,cts,mts,js,jsx,cjs,mjs,vue}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@eslint/eslintrc": "3.3.7",
        "@eslint/js": "10.0.1",
        "@typescript-eslint/eslint-plugin": "8.71.2",
        "@typescript-eslint/parser": "8.71.2",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vitest/browser-playwright": "5.0.5",
        "@vitest/coverage-v8": "5.0.5",
        "bpmn-moddle": "10.3.1",
        "bpmnlint": "11.15.0",
        "camunda-bpmn-moddle": "8.0.2",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "jsdom": "30.1.3",
        "knip": "6.42.0",
        "lint-staged": "17.6.0",
        "npm-run-all": "4.1.5",
        "playwright": "1.64.1",
        "prettier": "3.9.10",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "vite": "8.3.4",
        "vitest": "5.0.5"
    },
    "resolutions": {
        "shell-quote": "1.11.0",
        "proxy-addr": "2.0.8",
        "tar": "7.5.22",
        "preact": "10.29.8",
        "webpack": "5.110.3",
        "webpack-cli": "7.2.3",
        "bpmn-js-properties-panel": "patch:bpmn-js-properties-panel@npm%3A5.65.2#~/.yarn/patches/bpmn-js-properties-panel-npm-5.65.2-5f05209da3.patch",
        "decompress": "patch:@xhmikosr/decompress@npm%3A11.1.4#~/.yarn/patches/xhmikosr-decompress-npm-11.1.4-commonjs.patch",
        "camunda-transaction-boundaries": "patch:camunda-transaction-boundaries@npm%3A1.1.2#~/.yarn/patches/camunda-transaction-boundaries-npm-1.1.2-8eb65b163b.patch",
        "vitepress/vite": "6.4.3"
    },
    "packageManager": "yarn@4.18.0"
}
